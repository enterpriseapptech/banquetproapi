// =====================================================================
// ENUMS — SHARED / CROSS-DOMAIN
// Used by models in more than one domain. Each was independently
// declared in 2+ of the original 7 schemas; unified here as the single
// source of truth. See docs/data/data-model.md for the full duplication
// inventory this resolves.
// =====================================================================

/// Unifies: booking, payments, notifications schemas' identical
/// {CATERING, EVENTCENTER} enum, plus users schema's {EVENTCENTERS
/// (plural — corrected to EVENTCENTER here, see the ⚠ note at the top of
/// this file), CATERING, ALL}.
enum ServiceType {
  EVENTCENTER
  CATERING
  /// only meaningful for the now-deprecated ServiceProvider.serviceType
  /// ("offers both categories") — not a valid value for any booking/
  /// invoice/review/timeslot-level field. Postgres enums can't restrict
  /// a value to one column only; this is an application-level
  /// validation concern.
  ALL
}

/// Unifies booking schema's InvoiceStatus {PENDING, PAID, OVERDUE,
/// GENERATED, PARTIALLY_PAID} and payments schema's separately-declared
/// InvoiceStatus {PENDING, PARTIALLY_PAID, OVER_PAID, PAID, OVERDUE} —
/// two different enums that happened to share a name, with overlapping
/// but non-identical values (booking had GENERATED, payments had
/// OVER_PAID). Union of both; nothing removed.
enum InvoiceStatus {
  PENDING
  GENERATED
  PARTIALLY_PAID
  PAID
  OVER_PAID
  OVERDUE
}

/// Unifies eventcenters/catering's byte-identical ServiceStatus.
enum ServiceStatus {
  ACTIVE
  INACTIVE
}

/// Unifies eventcenters/catering's byte-identical SubscriptionStatus.
enum SubscriptionStatus {
  PENDING
  ACTIVE
  INACTIVE
  EXPIRED
}

/// Unifies payments' live Status (used by Fees/SubscriptionPlans/
/// FeaturedPlans) and management's identically-named, identically-
/// valued, but unused Status enum.
enum Status {
  ACTIVE
  INACTIVE
}

