# BanquetPro API — environment variable reference
# This is a documentation template, not a working config. Copy the relevant
# section into each apps/<service>/.env — no service needs every variable below.
# See DOCUMENTATION.md section 8 for which service uses which variable.
# Never commit real secrets to this file or to any apps/*/.env file.

# ---- Common ----
NODE_ENV=development

# ---- Per-service database (each microservice owns its own DB) ----
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db_name>

# ---- RabbitMQ connection + queue name, one pair per downstream service ----
# Each app that talks to a given service needs that service's URL+QUEUE pair.
USERSURL=amqp://<user>:<password>@<host>:5672
USERSQUEUE=users_queue
EVENTSURL=amqp://<user>:<password>@<host>:5672
EVENTSQUEUE=events_queue
CATERINGURL=amqp://<user>:<password>@<host>:5672
CATERINGQUEUE=catering_queue
BOOKINGURL=amqp://<user>:<password>@<host>:5672
BOOKINGQUEUE=booking_queue
PAYMENTURL=amqp://<user>:<password>@<host>:5672
PAYMENTQUEUE=payment_queue
NOTIFICATIONURL=amqp://<user>:<password>@<host>:5672
NOTIFICATIONQUEUE=notification_queue
MANAGEMENTURL=amqp://<user>:<password>@<host>:5672
MANAGEMENTQUEUE=management_queue

# ---- Auth (gateway + users service) ----
JWT_ACCESS_TOKEN_SECRET=<random-secret>
JWT_REFRESH_TOKEN_SECRET=<random-secret>
JWT_EXPIRES_IN=59m
FRONTEND_URL=https://<your-frontend-domain>

# ---- Cloudinary (gateway — image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payments (payments service) ----
STRIPE_SECRET=
PAYSTACK_SECRET_KEY=
# NOT currently read anywhere in the codebase — required to fix the unsigned-webhook
# gap documented in KNOWN_GAPS.md GAP-013. Add these once webhook verification is implemented.
STRIPE_WEBHOOK_SECRET=
PAYSTACK_WEBHOOK_SECRET=
INVOICE_VALID_NO_OF_DAYS=7
REFUND_PROCESSING_DAY=7
HOLD_PAYMENT_IN_ESCROW_WALLET=true

# ---- Notifications (notifications service — outbound SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Docker Compose infra (postgres + rabbitmq containers) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
